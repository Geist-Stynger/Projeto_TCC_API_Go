# Portas expostas no host
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Configurações do Back-end (Go / Gin)
GIN_MODE=release
JWT_SECRET=troque-esta-chave-secreta-em-producao
BACKEND_DATA_DIR=./back-end/files

# URL da API usada no build do Front-end
# Em Docker, "/api/v1" usa o proxy reverso do Nginx (funciona em localhost e na rede local)
VITE_API_URL=/api/v1
